# Veklom Ops MCP — names only. Never commit real secret values.
VEKLOM_MCP_ENVIRONMENT=production
VEKLOM_MCP_ACCESS_TOKEN=
VEKLOM_MCP_ALLOW_UNAUTHENTICATED=false
VEKLOM_MCP_WRITES_ENABLED=false
# Verification key only. The matching PRIVATE key must never be mounted into this MCP container.
VEKLOM_MCP_APPROVAL_PUBLIC_KEY_B64=
# Unique name for this deployment; approvals are bound to it (required when writes are enabled).
VEKLOM_MCP_APPROVAL_AUDIENCE=
# Approver page (approver/ hosted on its OWN origin, e.g. Cloudflare Pages) and this server's public URL.
# With both set, approval requests carry a tap-to-approve link and approvals are delivered automatically.
VEKLOM_MCP_APPROVER_URL=
VEKLOM_MCP_PUBLIC_URL=
# Optional tighten-only policy file (see policy.example.json).
VEKLOM_MCP_POLICY_FILE=
# Optional: stream audit event hashes off-box.
VEKLOM_MCP_AUDIT_ANCHOR_URL=
VEKLOM_MCP_AUDIT_ANCHOR_TOKEN=

# Docker gate: the only container that mounts the Docker socket. Generate two DIFFERENT random tokens.
# The MCP uses the read token for reads and the act token for restart/stop/start.
DOCKER_GATE_READ_TOKEN=
DOCKER_GATE_ACT_TOKEN=
# Second, independent switch for lifecycle actions; checked by the gate itself.
DOCKER_GATE_ALLOW_ACT=false
# Only containers carrying this label are visible or actionable.
DOCKER_GATE_MANAGED_LABEL=veklom.ops.managed=true
# Group id that owns /var/run/docker.sock on the host (stat -c %g /var/run/docker.sock).
DOCKER_SOCKET_GID=999

# generic (default) or veklom. The veklom profile enables the legacy Veklom probes below.
VEKLOM_MCP_PROFILE=generic
# Generic health probes: {"api":"https://api.example.com"}
VEKLOM_MCP_HEALTH_TARGETS=
VEKLOM_MCP_SECURITY_POSTURE_URL=

VEKLOM_BYOS_BASE_URL=https://api.veklom.com
VEKLOM_CAPPO_BASE_URL=https://cappo.veklom.com
VEKLOM_PGL_BASE_URL=https://pgl.veklom.com
VEKLOM_CAPI_BASE_URL=https://capi.veklom.com
# Only configure if an internal/private path is intentionally available to this container.
VEKLOM_LOCKERPHYCER_BASE_URL=

VEKLOM_MCP_REQUEST_TIMEOUT=12
VEKLOM_MCP_MAX_LOG_LINES=200
VEKLOM_MCP_MAX_RESPONSE_CHARS=120000
VEKLOM_MCP_APPROVAL_TTL_SECONDS=600

# Set to the hostname clients use (e.g. your Cloudflare Tunnel hostname). Enables the SDK's
# DNS-rebinding guard for exactly these hosts; without it only the bearer token protects /mcp.
MCP_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=
